# Docker Compose reads this from the project root as `.env` (gitignored).
# Copy to `C:\sf\testflow-\.env` and fill in values to enable Supabase persistence.

REDIS_URL=redis://localhost:6379/0
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Storage mode:
#   USE_DEMO_DATA=true  -> in-memory demo (no persistence)
#   USE_DEMO_DATA=false -> persist to Supabase (both values below REQUIRED)
USE_DEMO_DATA=false
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Encrypts Auth Profile credentials at rest (generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ). If unset, TestFlow derives a key from SUPABASE_SERVICE_ROLE_KEY.
TESTFLOW_SECRET_KEY=

# Docker Record Test: run on the host while compose is up:
#   cd backend && python host_recorder_main.py
RECORDING_DELEGATE_URL=http://host.docker.internal:8765
HOST_RECORDER_PORT=8765
