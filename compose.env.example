# Docker Compose reads this from the project root as `.env` (gitignored).
# Copy to `C:\sf\testflow-\.env` and fill in values to enable Supabase persistence.

# Host-side Redis URL. Compose overrides this inside containers to redis://redis:6379/0.
REDIS_URL=redis://localhost:6379/0
REDIS_HOST_PORT=6380
BACKEND_PORT=8000
FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000
# Browser calls. Also passed as a frontend image build arg; rebuild after changing it.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api
# Next.js server inside the frontend container. Not used by the browser.
INTERNAL_API_URL=http://backend:8000/api

# Storage mode:
#   USE_DEMO_DATA=true  -> in-memory demo (no persistence)
#   USE_DEMO_DATA=false -> persist to Supabase (both values below REQUIRED)
USE_DEMO_DATA=false
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Encrypts Auth Profile credentials at rest (generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ). Required for Auth Profiles; keep this value stable. Never commit the real key.
TESTFLOW_SECRET_KEY=

# API authentication (see backend/.env.example). Empty -> verify via the project's JWKS.
SUPABASE_JWT_SECRET=
# Dev-only bypass, honoured only with USE_DEMO_DATA=true.
AUTH_DISABLED=false

# Docker Record Test: run on the host while compose is up:
#   cd backend && python host_recorder_main.py
RECORDING_DELEGATE_URL=http://host.docker.internal:8765
HOST_RECORDER_PORT=8765

# Maximum Playwright jobs executed concurrently by the Node worker.
WORKER_CONCURRENCY=3

# Worker timeouts and recovery.
# Whole-test limit and per-step (Playwright action/navigation) limit.
TEST_TIMEOUT_MS=300000
STEP_TIMEOUT_MS=30000
# Heartbeat lease for a claimed job; a job whose lease expires is requeued once, then failed.
JOB_LEASE_SECONDS=60
# Backend sweep: Queued/Running runs older than this are marked Failed.
STUCK_RUN_AFTER_MINUTES=60

# Workers page: worker heartbeat period (backend uses it to flag stale workers, 3x this).
WORKER_STATUS_INTERVAL_MS=5000
# Optional: git commit shown next to the worker version (e.g. GIT_SHA=$(git rev-parse --short HEAD)).
GIT_SHA=

# Warm runners. Chromium is launched at worker start and kept running.
# Spare blank browser contexts per worker for tests without an Auth Profile (0..WORKER_CONCURRENCY).
WARM_CONTEXTS=1
# Relaunch Chromium (between tests, never mid-test) after this many tests, or when the worker
# process tree (Node + Chromium) uses more than this much memory.
BROWSER_RECYCLE_AFTER_TESTS=200
BROWSER_RECYCLE_RSS_MB=1500
