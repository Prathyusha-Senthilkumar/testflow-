# Docker Compose reads this from the project root as `.env` (gitignored).
# Copy to `C:\sf\testflow-\.env` and fill in values to enable Supabase persistence.

# Host-side Redis URL. Compose overrides this inside containers to redis://redis:6379/0.
REDIS_URL=redis://localhost:6379/0
REDIS_HOST_PORT=6380
BACKEND_PORT=8000
FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000
# Browser calls. Also passed as a frontend image build arg; rebuild after changing it.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api
# Next.js server inside the frontend container. Not used by the browser.
INTERNAL_API_URL=http://backend:8000/api

# Storage mode:
#   USE_DEMO_DATA=true  -> in-memory demo (no persistence)
#   USE_DEMO_DATA=false -> persist to Supabase (both values below REQUIRED)
USE_DEMO_DATA=false
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Encrypts Auth Profile credentials at rest (generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ). Required for Auth Profiles; keep this value stable. Never commit the real key.
TESTFLOW_SECRET_KEY=

# Docker Record Test: run on the host while compose is up:
#   cd backend && python host_recorder_main.py
RECORDING_DELEGATE_URL=http://host.docker.internal:8765
HOST_RECORDER_PORT=8765

# Maximum Playwright jobs executed concurrently by the Node worker.
WORKER_CONCURRENCY=3
