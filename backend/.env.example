PORT=8001
FRONTEND_URL=http://localhost:3000
# Storage mode: true = in-memory demo; false = persist to Supabase (creds required below)
USE_DEMO_DATA=true
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
REDIS_URL=redis://localhost:6379/0
# Optional when API runs in Docker; start host recorder: python host_recorder_main.py
RECORDING_DELEGATE_URL=http://host.docker.internal:8765