PORT=8001
FRONTEND_URL=http://localhost:3000
# Storage mode: true = in-memory demo; false = persist to Supabase (creds required below)
USE_DEMO_DATA=true
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
REDIS_URL=redis://localhost:6379/0
# Optional when API runs in Docker; start host recorder: python host_recorder_main.py
RECORDING_DELEGATE_URL=http://host.docker.internal:8765
# Required for Auth Profiles. Generate once with Fernet.generate_key(); keep stable and secret.
TESTFLOW_SECRET_KEY=YOUR_STABLE_FERNET_KEY

# API authentication. Supabase access tokens are verified locally.
# Legacy HS256 projects: Supabase dashboard -> Settings -> API -> JWT secret.
# Leave empty to verify with the project's JWKS (asymmetric signing keys) instead.
SUPABASE_JWT_SECRET=
# Dev-only: skip API auth. Ignored unless USE_DEMO_DATA=true. Never set in shared environments.
AUTH_DISABLED=false

# Queued/Running runs older than this are marked Failed by the stuck-run sweep.
STUCK_RUN_AFTER_MINUTES=60
STUCK_RUN_SWEEP_SECONDS=300
